TAILSCALE_OWNER=you@example.com
FIVEK_DATA_DIR=/var/lib/fivek/data
GARMIN_TOKEN_STORE=/var/lib/fivek/garmin_tokens
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=replace-privately
FIVEK_CALENDAR_KEY_FILE=/etc/fivek/calendar.key
FIVEK_TIMEZONE=Europe/London
FIVEK_AGE=30
FIVEK_HEIGHT_CM=175
FIVEK_SEX=male

# Shared by the app and private proxy; root becomes the private app directory.
FIVEK_BASE_PATH=/running/
