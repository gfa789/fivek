# Copy to .env or set these in your process environment. Do not commit credentials.
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=replace-with-your-password
# Optional. Defaults to ./data/garmin_tokens
GARMIN_TOKEN_STORE=./data/garmin_tokens

# 5K training pipeline (optional)
FIVEK_DATA_DIR=./data/fivek
FIVEK_TARGET_DATE=2027-01-01
FIVEK_TIMEZONE=Europe/London
# Defaults to the oldest recorded activity (one year if there are no activities).
# Set an earlier date to also import wellness history before your first activity.
# FIVEK_HISTORY_START=2025-01-01
FIVEK_REQUEST_DELAY=0.25
